<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ArkServerManager.Installer</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ArkServerManager.Desktop/ArkServerManager.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(InstallerPayloadZip)' != ''">
    <EmbeddedResource Include="$(InstallerPayloadZip)" LogicalName="ArkServerManager.InstallerPayload.zip" />
  </ItemGroup>
</Project>
