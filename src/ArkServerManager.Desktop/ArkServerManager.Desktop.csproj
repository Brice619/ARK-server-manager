<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets/ark-logo.ico</ApplicationIcon>
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants Condition="'$(EnableDesignReview)' == 'true'">$(DefineConstants);DESIGN_REVIEW</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" Exclude="Assets/approved-mods.png" />
    <AvaloniaResource Include="Assets/approved-mods.png" Condition="'$(EnableDesignReview)' == 'true'" />
    <Compile Remove="DesignReview.cs;ApprovedManagementReview.cs;ApprovedClusterActivityReview.cs;ApprovedClusterBackupsReview.cs" Condition="'$(EnableDesignReview)' != 'true'" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <ProjectReference Include="../ArkServerManager.Core/ArkServerManager.Core.csproj" RemoveProperties="EnableDesignReview" />
    <ProjectReference Include="../ArkServerManager.Host/ArkServerManager.Host.csproj" ReferenceOutputAssembly="false" RemoveProperties="EnableDesignReview" />
    <ProjectReference Include="../ArkServerManager.Updater/ArkServerManager.Updater.csproj" ReferenceOutputAssembly="false" RemoveProperties="EnableDesignReview" />
  </ItemGroup>
  <Target Name="BundleManagerForDesktopBuild" AfterTargets="Build">
    <MSBuild Projects="../ArkServerManager.Host/ArkServerManager.Host.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" RemoveProperties="EnableDesignReview">
      <Output TaskParameter="TargetOutputs" ItemName="ManagerBuildEntry" />
    </MSBuild>
    <ItemGroup>
      <ManagerBuildFiles Include="%(ManagerBuildEntry.RootDir)%(ManagerBuildEntry.Directory)**/*"
                         Exclude="%(ManagerBuildEntry.RootDir)%(ManagerBuildEntry.Directory)**/*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(ManagerBuildFiles)" DestinationFolder="$(OutDir)manager/%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="BundleUpdaterForDesktopBuild" AfterTargets="Build">
    <MSBuild Projects="../ArkServerManager.Updater/ArkServerManager.Updater.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" RemoveProperties="EnableDesignReview">
      <Output TaskParameter="TargetOutputs" ItemName="UpdaterBuildEntry" />
    </MSBuild>
    <ItemGroup>
      <UpdaterBuildFiles Include="%(UpdaterBuildEntry.RootDir)%(UpdaterBuildEntry.Directory)**/*"
                         Exclude="%(UpdaterBuildEntry.RootDir)%(UpdaterBuildEntry.Directory)**/*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterBuildFiles)" DestinationFolder="$(OutDir)updater/%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishBundledUpdater" AfterTargets="ComputeFilesToPublish">
    <PropertyGroup>
      <UpdaterPublishDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)updater-publish/'))</UpdaterPublishDirectory>
    </PropertyGroup>
    <MSBuild Projects="../ArkServerManager.Updater/ArkServerManager.Updater.csproj" Targets="Publish"
             RemoveProperties="EnableDesignReview;PublishProfile;PublishUrl"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(UpdaterPublishDirectory)" />
    <ItemGroup>
      <UpdaterPublishFiles Include="$(UpdaterPublishDirectory)**/*" />
      <ResolvedFileToPublish Include="@(UpdaterPublishFiles)">
        <RelativePath>updater/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="PublishBundledManager" AfterTargets="ComputeFilesToPublish">
    <PropertyGroup>
      <ManagerPublishDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)manager-publish/'))</ManagerPublishDirectory>
    </PropertyGroup>
    <MSBuild Projects="../ArkServerManager.Host/ArkServerManager.Host.csproj" Targets="Publish"
             RemoveProperties="EnableDesignReview;PublishProfile;PublishUrl"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(ManagerPublishDirectory)">
    </MSBuild>
    <ItemGroup>
      <ManagerPublishFiles Include="$(ManagerPublishDirectory)**/*" />
      <ResolvedFileToPublish Include="@(ManagerPublishFiles)">
        <RelativePath>manager/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
