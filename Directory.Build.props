<Project>
  <PropertyGroup>
    <Version>0.2.0</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ArkServerManager.Desktop' and '$(EnableDesignReview)' == 'true'">
    <BaseIntermediateOutputPath>obj/design-review/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(MSBuildProjectDirectory)/obj/</MSBuildProjectExtensionsPath>
    <BaseOutputPath>bin/design-review/</BaseOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ARK_RELEASE_VERSION)' != ''">
    <Version>$(ARK_RELEASE_VERSION)</Version>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Link="licenses/ARKServerManager.LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
